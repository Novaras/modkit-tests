-- modkit test weapon: a copy of stock `vgr_bcforwardweapon` (the Vaygr Battlecruiser's forward gun) changed in one setting,
-- accuracy 1 against everything (stock: 0.4 against Frigates), for `test engine/bursts`
-- (scripts/modkit/tests/engine/bursts.lua), which looks for bursts fired at empty points in space.
StartWeaponConfig(NewWeaponType,"Gimble","Bullet","Vgr_Laser","Normal Only",4000,5550,0,0,0,0,1,1,1,15,0,0,0,0,260,40,0.1,"Normal",0,0,0);
AddWeaponResult(NewWeaponType,"Hit","DamageHealth","Target",7600,7600,"");
setMagneticFieldPenetration(NewWeaponType,-800,{MagneticField,-800});
setPenetration(NewWeaponType,100,1,
{TurretArmour=0.5},
{PlanetKillerArmour=0},
{SwarmerArmor=0.10},
{SpaceMineArmor=1},
{TorpedoArmor=0},
{HeavyMissileArmor=0},
{SmallMissileArmor=0},
{HeavyArmour=1.10},
{SubSystemArmour=0.3});
setAccuracy(NewWeaponType, 1); -- (the only change: the stock table has Frigate=0.4)
setAngles(NewWeaponType,6,0,0,0,0);
setMiscValues(NewWeaponType,4,0.5);
setLifetimeMult(NewWeaponType, 2.0);
setBallistics(NewWeaponType,1,0.0,0.0);
setFireMultFactor(NewWeaponType, 1.0);
